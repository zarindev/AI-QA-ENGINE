# QA Pilot environment. Copy to .env (setup.bat / setup.sh does this for you).

# Your own Anthropic API key — the ONLY external service QA Pilot talks to.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model used by every AI stage (override per-run in Settings).
QAP_MODEL=claude-sonnet-5-5

# Fernet key that encrypts role credentials in workspace/<project>/secrets.enc.
# Leave blank: it is generated automatically on first run and written here.
QAP_SECRET_KEY=

# Optional: move the workspace folder somewhere else (absolute path).
QAP_WORKSPACE=
